#!/bin/bash
set -euo pipefail

# Sanitized example launcher for MrsMThatcher.
#
# Copy this to a private, untracked launcher such as runMrsMThatcher2 and
# replace every placeholder below with real secrets from your password manager.
# Do not commit the real launcher.

export X_CONSUMER_KEY='replace-with-x-consumer-key'
export X_CONSUMER_SECRET='replace-with-x-consumer-secret'
export X_ACCESS_TOKEN='replace-with-x-access-token'
export X_ACCESS_SECRET='replace-with-x-access-secret'
export X_MY_USER_ID='replace-with-x-user-id'
export X_BEARER_TOKEN='replace-with-x-bearer-token'
export XAI_API_KEY='replace-with-xai-api-key'

if [[ "$X_CONSUMER_KEY" == replace-* || "$XAI_API_KEY" == replace-* ]]; then
  echo "Refusing to start: edit runMrsMThatcher2_example placeholders first." >&2
  exit 2
fi

while true; do
  /usr/local/bin/mrsMThatcher2.py >/dev/null 2>&1
  sleep 3600
done
