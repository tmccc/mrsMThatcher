{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defect_ledger.schema.json",
  "title": "MrsMThatcher evidence-cut-off defect ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ledger_id",
    "as_of",
    "identity_scope",
    "external_evidence",
    "status_taxonomy",
    "markdown",
    "defects"
  ],
  "properties": {
    "$schema": {
      "const": "./defect_ledger.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "ledger_id": {
      "const": "mrsMThatcher-defect-evidence-ledger"
    },
    "as_of": {
      "$ref": "#/$defs/date"
    },
    "identity_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_baseline",
        "ledger_evidence_cutoff",
        "candidate_under_review",
        "production_deployment_observation",
        "post_merge_regeneration"
      ],
      "properties": {
        "production_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "tree",
            "role"
          ],
          "properties": {
            "commit": {
              "$ref": "#/$defs/hash"
            },
            "tree": {
              "$ref": "#/$defs/hash"
            },
            "role": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "ledger_evidence_cutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "tree",
            "as_of",
            "difference_from_production_baseline",
            "meaning"
          ],
          "properties": {
            "commit": {
              "$ref": "#/$defs/hash"
            },
            "tree": {
              "$ref": "#/$defs/hash"
            },
            "as_of": {
              "$ref": "#/$defs/date"
            },
            "difference_from_production_baseline": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "meaning": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "candidate_under_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity_source",
            "stored_in_ledger",
            "required_attestation_fields",
            "explanation"
          ],
          "properties": {
            "identity_source": {
              "const": "external-release-attestation"
            },
            "stored_in_ledger": {
              "const": false
            },
            "required_attestation_fields": {
              "type": "array",
              "const": [
                "base_commit",
                "candidate_commit",
                "candidate_tree"
              ]
            },
            "explanation": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "production_deployment_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_commit",
            "repository_tree",
            "observed_at",
            "source",
            "loaded_process_identity_status",
            "loaded_process_identity_explanation",
            "freshness_warning"
          ],
          "properties": {
            "repository_commit": {
              "$ref": "#/$defs/hash"
            },
            "repository_tree": {
              "$ref": "#/$defs/hash"
            },
            "observed_at": {
              "$ref": "#/$defs/dateTime"
            },
            "source": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "loaded_process_identity_status": {
              "enum": [
                "attested",
                "installed-files-observed-process-commit-unattested",
                "unattested"
              ]
            },
            "loaded_process_identity_explanation": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "freshness_warning": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "post_merge_regeneration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "release_base_must_equal_evidence_cutoff",
            "triggers",
            "requirement"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "release_base_must_equal_evidence_cutoff": {
              "const": true
            },
            "triggers": {
              "type": "array",
              "const": [
                "production-baseline-advanced",
                "defect-status-changed",
                "invariant-status-changed",
                "deployment-evidence-changed"
              ]
            },
            "requirement": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "external_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/externalEvidence"
      }
    },
    "status_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "latent-disabled",
        "repaired-not-deployed",
        "deployed-unverified",
        "deployed-verified",
        "assurance-weakness",
        "superseded"
      ],
      "properties": {
        "active": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "latent-disabled": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "repaired-not-deployed": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "deployed-unverified": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "deployed-verified": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "assurance-weakness": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "superseded": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "purpose",
        "source_of_truth",
        "sort_key",
        "unknown_policy",
        "columns"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_of_truth": {
          "const": "defect_ledger.json"
        },
        "sort_key": {
          "const": "id"
        },
        "unknown_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "columns": {
          "type": "array",
          "const": [
            "ID",
            "Status",
            "Severity",
            "Finding",
            "Invariants",
            "Introduced",
            "Fix",
            "Deployment"
          ]
        }
      }
    },
    "defects": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/defect"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "affectedPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\s)[A-Za-z0-9._*?\\[\\]/-]+$"
    },
    "commit": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "status": {
      "enum": [
        "active",
        "latent-disabled",
        "repaired-not-deployed",
        "deployed-unverified",
        "deployed-verified",
        "assurance-weakness",
        "superseded"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "assurance"
      ]
    },
    "defectClass": {
      "enum": [
        "runtime-defect",
        "latent-runtime-defect",
        "assurance-weakness",
        "historical-umbrella"
      ]
    },
    "invariantId": {
      "type": "string",
      "pattern": "^INV-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$"
    },
    "introduced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_bad_commit",
        "last_known_good_commit",
        "affected_range",
        "confidence",
        "explanation"
      ],
      "properties": {
        "first_bad_commit": {
          "$ref": "#/$defs/commit"
        },
        "last_known_good_commit": {
          "$ref": "#/$defs/commit"
        },
        "affected_range": {
          "type": "string",
          "pattern": "^(?:unknown|inclusive:(?:unknown|[0-9a-f]{40})\\.\\.[0-9a-f]{40})$"
        },
        "confidence": {
          "enum": [
            "exact",
            "bounded",
            "unknown"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "reviewed_revision",
        "scope",
        "exclusions",
        "source"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "reviewed_revision": {
          "$ref": "#/$defs/commit"
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "exclusions": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "revision",
        "method",
        "reproducer",
        "source"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "revision": {
          "$ref": "#/$defs/commit"
        },
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reproducer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "nodeid",
        "kind",
        "commit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeid": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "regression",
            "integration",
            "safety-meta",
            "none"
          ]
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "commit",
        "summary"
      ],
      "properties": {
        "state": {
          "enum": [
            "fixed",
            "unfixed",
            "not-applicable"
          ]
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observed_commit",
        "observed_at",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-deployed",
            "deployed-verified",
            "deployed-unverified",
            "not-applicable",
            "unknown"
          ]
        },
        "observed_commit": {
          "$ref": "#/$defs/commit"
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference",
        "claim"
      ],
      "properties": {
        "type": {
          "enum": [
            "code",
            "test",
            "commit",
            "report",
            "runtime-observation",
            "artifact"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "externalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "repository_relative_path",
        "observed_absolute_path",
        "sha256",
        "availability",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXT-[A-Z0-9-]+$"
        },
        "classification": {
          "const": "external-production-record"
        },
        "repository_relative_path": {
          "$ref": "#/$defs/affectedPath"
        },
        "observed_absolute_path": {
          "type": "string",
          "pattern": "^/[^\\n]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "availability": {
          "enum": [
            "external-untracked",
            "unresolved"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "explanation"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurred",
        "evidence",
        "explanation"
      ],
      "properties": {
        "occurred": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes",
        "superseded_by",
        "related"
      ],
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEF-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEF-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEF-[0-9]{4}$"
          },
          "uniqueItems": true
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_class",
        "defect_class",
        "diagnosis_finding",
        "status",
        "severity",
        "invariant_ids",
        "components",
        "affected_files",
        "runtime_lanes",
        "incident",
        "summary",
        "impact",
        "introduced",
        "chronology",
        "first_review_scope",
        "detection",
        "tests",
        "fix",
        "deployment",
        "residual_risk",
        "evidence",
        "unknowns",
        "relations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEF-[0-9]{4}$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_class": {
          "enum": [
            "diagnosis-finding",
            "diagnosis-finding-child",
            "established-related"
          ]
        },
        "defect_class": {
          "$ref": "#/$defs/defectClass"
        },
        "diagnosis_finding": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/invariantId"
          },
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "affected_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/affectedPath"
          },
          "uniqueItems": true
        },
        "runtime_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "incident": {
          "$ref": "#/$defs/incident"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "introduced": {
          "$ref": "#/$defs/introduced"
        },
        "chronology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "event",
              "commit",
              "evidence"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "event": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "commit": {
                "$ref": "#/$defs/commit"
              },
              "evidence": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "first_review_scope": {
          "$ref": "#/$defs/reviewScope"
        },
        "detection": {
          "$ref": "#/$defs/detection"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "fix": {
          "$ref": "#/$defs/fix"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "residual_risk": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        },
        "relations": {
          "$ref": "#/$defs/relations"
        }
      }
    }
  }
}
