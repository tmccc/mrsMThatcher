[Unit]
Description=MrsMThatcher read-only engagement analytics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/disks/disk1/etc/mrsMThatcher
ExecStart=/bin/bash -lc 'source /disks/disk1/etc/mrsMThatcher/mrsMThatcher.env && exec /usr/bin/python3 /disks/disk1/etc/mrsMThatcher/mrs_engagement_analytics.py scheduled-run --project-dir /disks/disk1/etc/mrsMThatcher --since-days 14 --execute-read --max-api-requests 2'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/disks/disk1/etc/mrsMThatcher/engagement_analytics
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
TimeoutStartSec=5min

# User-unit example. Install as ~/.config/systemd/user/mrs-engagement-analytics.service.
