[Unit]
Description=Run MrsMThatcher semantic-veto shadow health check daily at 23:35

[Timer]
OnCalendar=*-*-* 23:35:00 Europe/London
Persistent=true
AccuracySec=1s
Unit=mrs-semantic-veto-shadow-health.service

[Install]
WantedBy=timers.target

# User unit. Install as ~/.config/systemd/user/mrs-semantic-veto-shadow-health.timer.
