[Unit]
Description=Evaluate MrsMThatcher bot health for Home Assistant
After=mrsMThatcher.service

[Service]
Type=oneshot
WorkingDirectory=/disks/disk1/etc/mrsMThatcher
EnvironmentFile=-%h/.config/mrsMThatcher/bot-health-monitor.env
ExecStart=/usr/bin/python3 /disks/disk1/etc/mrsMThatcher/mrs_bot_health_monitor.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
TimeoutStartSec=20s
StandardOutput=journal
StandardError=journal
