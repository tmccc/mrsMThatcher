{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/mrsMThatcher/production_invariants.schema.json",
  "title": "MrsMThatcher production invariant registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registry_id",
    "registry_version",
    "baseline_commit",
    "reviewed_on",
    "scope",
    "generated_document",
    "status_definitions",
    "verification_definitions",
    "priority0_control_paths",
    "generated_artifact_classifications",
    "expected_full_suite_skips",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "const": "production_invariants.schema.json"
    },
    "registry_id": {
      "const": "mrsMThatcher-production-invariants"
    },
    "registry_version": {
      "const": 2
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "generated_document": {
      "const": "PRODUCTION_INVARIANTS.md"
    },
    "status_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implemented",
        "partial",
        "missing"
      ],
      "properties": {
        "implemented": {
          "type": "string",
          "minLength": 1
        },
        "partial": {
          "type": "string",
          "minLength": 1
        },
        "missing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "partial",
        "unverified"
      ],
      "properties": {
        "verified": {
          "type": "string",
          "minLength": 1
        },
        "partial": {
          "type": "string",
          "minLength": 1
        },
        "unverified": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priority0_control_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repositoryPath"
      }
    },
    "generated_artifact_classifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/generatedArtifactClassification"
      }
    },
    "expected_full_suite_skips": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/expectedFullSuiteSkip"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/invariant"
      }
    }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\*\\?\\[]).+"
    },
    "testNode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tests/[^:]+\\.py(?:::[A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]]+\\])?)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generatedArtifactClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact",
        "artifact_sha256",
        "classification",
        "runtime_relationship_required",
        "current_companion",
        "owner",
        "bound_artifact",
        "bound_artifact_sha256",
        "observed_current_bound_artifact_sha256",
        "bound_commit",
        "policy_version",
        "builder_evidence",
        "runtime_loader_evidence",
        "validator_tests",
        "invariant_ids",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ARTIFACT-CLASS-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "artifact": {
          "$ref": "#/definitions/repositoryPath"
        },
        "artifact_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "classification": {
          "enum": [
            "direct_companion",
            "historical_build_time"
          ]
        },
        "runtime_relationship_required": {
          "type": "boolean"
        },
        "current_companion": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "bound_artifact": {
          "$ref": "#/definitions/repositoryPath"
        },
        "bound_artifact_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "observed_current_bound_artifact_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "bound_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "builder_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidenceReference"
          }
        },
        "runtime_loader_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidenceReference"
          }
        },
        "validator_tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/testNode"
          }
        },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectedFullSuiteSkip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "reason_code",
        "reason_regex",
        "condition",
        "invariant_ids",
        "prevents_release_qualification",
        "justification",
        "compensating_evidence"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/definitions/testNode"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "reason_regex": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "const": "inside_outer_release_gate_containment"
        },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        },
        "prevents_release_qualification": {
          "type": "boolean"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "compensating_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "selectors",
        "purpose"
      ],
      "properties": {
        "validation_id": {
          "enum": [
            "pytest",
            "registry_validate"
          ]
        },
        "selectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tests/[A-Za-z0-9_./-]+\\.py(?:::[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unverified"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "tests",
        "validations"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPath"
          }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/testNode"
          }
        },
        "validations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/validation"
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "statement",
        "rationale",
        "owner_subsystem",
        "runtime_consumed_artifacts",
        "preconditions",
        "failure_mode",
        "failure_if_violated",
        "criticality",
        "implementation_status",
        "status_rationale",
        "verification",
        "full_suite_relevance",
        "required_production_deployed_path_checks",
        "evidence_references",
        "last_verified_commit",
        "last_verified_tree",
        "accepted_residual_risk",
        "affected_paths",
        "enforcement",
        "known_gaps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^INV-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "category": {
          "enum": [
            "eligibility_evidence",
            "transaction",
            "configuration_process",
            "test_deployment"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "owner_subsystem": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "runtime_consumed_artifacts": {
          "$ref": "#/definitions/runtimeArtifactSet"
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_mode": {
          "$ref": "#/definitions/failureMode"
        },
        "failure_if_violated": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "enum": [
            "critical",
            "high"
          ]
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "partial",
            "missing"
          ]
        },
        "status_rationale": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "$ref": "#/definitions/verification"
        },
        "full_suite_relevance": {
          "$ref": "#/definitions/fullSuiteRelevance"
        },
        "required_production_deployed_path_checks": {
          "$ref": "#/definitions/deployedPathChecks"
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidenceReference"
          }
        },
        "last_verified_commit": {
          "$ref": "#/definitions/revisionEvidence"
        },
        "last_verified_tree": {
          "$ref": "#/definitions/revisionEvidence"
        },
        "accepted_residual_risk": {
          "$ref": "#/definitions/residualRisk"
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPath"
          }
        },
        "enforcement": {
          "$ref": "#/definitions/enforcement"
        },
        "known_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimeArtifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifacts",
        "explanation"
      ],
      "properties": {
        "status": {
          "enum": [
            "direct",
            "indirect",
            "none",
            "unknown"
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frozen_candidate_required_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPath"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failureMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "explanation"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fail_closed",
            "fail_open",
            "mixed",
            "not_applicable",
            "unknown"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fullSuiteRelevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "explanation"
      ],
      "properties": {
        "status": {
          "enum": [
            "required",
            "supporting",
            "not_applicable",
            "unknown"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deployedPathChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "explanation"
      ],
      "properties": {
        "status": {
          "enum": [
            "required",
            "not_applicable",
            "unknown"
          ]
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference",
        "claim"
      ],
      "properties": {
        "type": {
          "enum": [
            "artifact",
            "code",
            "commit",
            "operational",
            "report",
            "test"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "explanation"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "residualRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "explanation"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "accepted",
            "unaccepted",
            "unknown"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
