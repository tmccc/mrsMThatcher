{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mrs-m-thatcher:quote-research:schema:2",
  "title": "Margaret Thatcher quotation research database",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "database_revision",
    "generated_at",
    "source_file",
    "methodology",
    "records",
    "unresolved_quotes",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "database_revision": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_file": { "$ref": "#/$defs/sourceFile" },
    "methodology": { "$ref": "#/$defs/methodology" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "unresolved_quotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedQuote" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "encoding",
        "line_endings",
        "source_occurrence_count",
        "unique_quote_count",
        "parser_version"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "encoding": { "type": "string", "minLength": 1 },
        "line_endings": { "enum": ["LF", "CRLF", "CR", "mixed"] },
        "source_occurrence_count": { "type": "integer", "minimum": 0 },
        "unique_quote_count": { "type": "integer", "minimum": 0 },
        "parser_version": { "type": "string", "minLength": 1 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "schema_frozen_at",
        "last_validated_at",
        "research_model_or_mode",
        "compiler_version",
        "semantic_validator_version"
      ],
      "properties": {
        "protocol_version": { "type": "string", "minLength": 1 },
        "schema_frozen_at": { "type": ["string", "null"], "format": "date-time" },
        "last_validated_at": { "type": ["string", "null"], "format": "date-time" },
        "research_model_or_mode": { "type": "string", "minLength": 1 },
        "compiler_version": { "type": "string", "minLength": 1 },
        "semantic_validator_version": { "type": "string", "minLength": 1 }
      }
    },
    "sourceOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_number"],
      "properties": {
        "line_number": { "type": "integer", "minimum": 1 }
      }
    },
    "relatedQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote_id", "relationship", "notes"],
      "properties": {
        "quote_id": { "$ref": "#/$defs/sha256" },
        "relationship": {
          "enum": [
            "excerpt_of",
            "expanded_by",
            "variant_of",
            "paraphrase_of",
            "component_of",
            "shares_source_passage",
            "possibly_related"
          ]
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_text",
        "text_variation_notes",
        "attributed_speaker",
        "verified_speaker",
        "principal_source_id",
        "principal_source_event_id",
        "principal_source_relationship",
        "uploaded_wording_origin_source_id",
        "direct_evidence_ids",
        "related_quotes",
        "publication_recommendation",
        "publication_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "exact",
            "normalised",
            "excerpt",
            "variant",
            "paraphrase",
            "composite",
            "misattributed",
            "unverified"
          ]
        },
        "verified_text": { "$ref": "#/$defs/nullableString" },
        "text_variation_notes": { "$ref": "#/$defs/nullableString" },
        "attributed_speaker": { "$ref": "#/$defs/nullableString" },
        "verified_speaker": { "$ref": "#/$defs/nullableString" },
        "principal_source_id": { "$ref": "#/$defs/nullableString" },
        "principal_source_event_id": { "$ref": "#/$defs/nullableString" },
        "principal_source_relationship": {
          "enum": [
            "exact_wording",
            "source_of_excerpt",
            "source_of_variant",
            "source_of_paraphrased_idea",
            "component_source",
            "misattribution_evidence",
            "none"
          ]
        },
        "uploaded_wording_origin_source_id": { "$ref": "#/$defs/nullableString" },
        "direct_evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "related_quotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/relatedQuote" }
        },
        "publication_recommendation": {
          "enum": [
            "eligible",
            "eligible_with_verified_wording",
            "hold_for_review",
            "exclude"
          ]
        },
        "publication_reason": { "type": "string", "minLength": 1 }
      }
    },
    "dateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "precision"],
      "properties": {
        "start": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "end": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "precision": {
          "enum": ["day", "month", "year", "approximate", "range", "undated", "unknown"]
        }
      }
    },
    "sourceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "relationship",
        "title",
        "communication_type",
        "occasion_type",
        "event_date",
        "publication_date",
        "venue_or_platform",
        "intended_audience",
        "delivery_status",
        "primary_source_available",
        "source_ids",
        "evidence_ids",
        "selection_reason"
      ],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "relationship": {
          "enum": [
            "principal",
            "component",
            "earlier_use",
            "later_reuse",
            "parallel_publication",
            "possible_occurrence"
          ]
        },
        "title": { "$ref": "#/$defs/nullableString" },
        "communication_type": {
          "enum": [
            "speech",
            "interview",
            "television_appearance",
            "radio_appearance",
            "parliamentary_debate",
            "press_conference",
            "book",
            "article",
            "letter",
            "private_conversation",
            "other",
            "unknown"
          ]
        },
        "occasion_type": {
          "enum": [
            "conference",
            "campaign",
            "parliamentary",
            "government",
            "party",
            "media",
            "publication",
            "private",
            "other",
            "unknown"
          ]
        },
        "event_date": { "$ref": "#/$defs/dateValue" },
        "publication_date": { "$ref": "#/$defs/dateValue" },
        "venue_or_platform": { "$ref": "#/$defs/nullableString" },
        "intended_audience": { "$ref": "#/$defs/nullableString" },
        "delivery_status": {
          "enum": [
            "recorded_delivery",
            "checked_against_delivery",
            "contemporary_transcript",
            "prepared_text_only",
            "published_text",
            "private_document",
            "reported_speech",
            "unknown"
          ]
        },
        "primary_source_available": { "enum": ["yes", "no", "unknown"] },
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selection_reason": { "type": "string", "minLength": 1 }
      }
    },
    "contextClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "epistemic_status", "evidence_ids"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "epistemic_status": {
          "enum": ["source_fact", "speaker_claim", "historian_inference", "editorial_inference"]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "historicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "immediate_trigger",
        "immediate_subject",
        "political_issue",
        "response_to_criticism",
        "current_event_reference",
        "surrounding_circumstances",
        "claims"
      ],
      "properties": {
        "summary": { "$ref": "#/$defs/nullableString" },
        "immediate_trigger": { "$ref": "#/$defs/nullableString" },
        "immediate_subject": { "$ref": "#/$defs/nullableString" },
        "political_issue": { "$ref": "#/$defs/nullableString" },
        "response_to_criticism": { "enum": ["yes", "no", "unknown"] },
        "current_event_reference": { "$ref": "#/$defs/nullableString" },
        "surrounding_circumstances": { "$ref": "#/$defs/nullableString" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextClaim" }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "type", "name", "canonical_name", "role", "scope", "evidence_ids"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "person",
            "place",
            "country",
            "organisation",
            "political_party",
            "international_organisation",
            "historical_event",
            "war",
            "economic_event",
            "legislation",
            "institution"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "canonical_name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["quote_text", "source_event", "historical_context", "editorial_guidance"] },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "literal_meaning",
        "intended_argument",
        "meaning_in_context",
        "broader_principle",
        "mechanism",
        "claimed_consequence"
      ],
      "properties": {
        "literal_meaning": { "$ref": "#/$defs/nullableString" },
        "intended_argument": { "$ref": "#/$defs/nullableString" },
        "meaning_in_context": { "$ref": "#/$defs/nullableString" },
        "broader_principle": { "$ref": "#/$defs/nullableString" },
        "mechanism": { "$ref": "#/$defs/nullableString" },
        "claimed_consequence": { "$ref": "#/$defs/nullableString" }
      }
    },
    "visualConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "priority",
        "depiction_mode",
        "concept",
        "rationale",
        "recommended_period",
        "recommended_location",
        "thatcher_presence",
        "must_include",
        "must_avoid"
      ],
      "properties": {
        "concept_id": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 1 },
        "depiction_mode": {
          "enum": [
            "speaking_occasion",
            "referenced_historical_event",
            "literal",
            "metaphorical",
            "institutional",
            "portrait_led"
          ]
        },
        "concept": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "recommended_period": { "$ref": "#/$defs/nullableString" },
        "recommended_location": { "$ref": "#/$defs/nullableString" },
        "thatcher_presence": { "enum": ["required", "optional", "avoid"] },
        "must_include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "must_avoid": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "accuracyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "strength", "basis", "evidence_ids"],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "strength": { "enum": ["required", "preferred", "avoid", "forbidden"] },
        "basis": { "const": "historical_fact" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "imageConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_subject",
        "secondary_subjects",
        "dominant_object",
        "largest_object",
        "required_relationships",
        "required_scale",
        "camera_position",
        "lighting",
        "foreground",
        "midground",
        "background",
        "viewer_eye_path",
        "required_objects",
        "forbidden_objects"
      ],
      "properties": {
        "primary_subject": { "$ref": "#/$defs/nullableString" },
        "secondary_subjects": { "type": "array", "items": { "type": "string" } },
        "dominant_object": { "$ref": "#/$defs/nullableString" },
        "largest_object": { "$ref": "#/$defs/nullableString" },
        "required_relationships": { "type": "array", "items": { "type": "string" } },
        "required_scale": { "$ref": "#/$defs/nullableString" },
        "camera_position": { "$ref": "#/$defs/nullableString" },
        "lighting": { "$ref": "#/$defs/nullableString" },
        "foreground": { "$ref": "#/$defs/nullableString" },
        "midground": { "$ref": "#/$defs/nullableString" },
        "background": { "$ref": "#/$defs/nullableString" },
        "viewer_eye_path": { "type": "array", "items": { "type": "string" } },
        "required_objects": { "type": "array", "items": { "type": "string" } },
        "forbidden_objects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "editorialGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guidance_status",
        "desired_first_impression",
        "suitable_visual_subjects",
        "suitable_symbolism",
        "visual_concepts",
        "historical_accuracy_requirements",
        "avoid",
        "common_misinterpretations",
        "image_generation_constraints"
      ],
      "properties": {
        "guidance_status": { "enum": ["ready", "provisional", "do_not_generate"] },
        "desired_first_impression": { "$ref": "#/$defs/nullableString" },
        "suitable_visual_subjects": { "type": "array", "items": { "type": "string" } },
        "suitable_symbolism": { "type": "array", "items": { "type": "string" } },
        "visual_concepts": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/visualConcept" }
        },
        "historical_accuracy_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/accuracyRequirement" }
        },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "common_misinterpretations": { "type": "array", "items": { "type": "string" } },
        "image_generation_constraints": { "$ref": "#/$defs/imageConstraints" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "creator_or_issuing_body",
        "passage_speaker",
        "host_or_repository",
        "source_kind",
        "primary_status",
        "source_format",
        "event_date",
        "publication_date",
        "canonical_url",
        "stable_document_id",
        "archive_reference",
        "edition",
        "isbn",
        "accessed_at"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "creator_or_issuing_body": { "$ref": "#/$defs/nullableString" },
        "passage_speaker": { "$ref": "#/$defs/nullableString" },
        "host_or_repository": { "$ref": "#/$defs/nullableString" },
        "source_kind": {
          "enum": [
            "recording",
            "transcript",
            "official_record",
            "archive_document",
            "book",
            "article",
            "interview",
            "scholarly_secondary",
            "contemporary_secondary",
            "editorial_note",
            "discovery_only",
            "other"
          ]
        },
        "primary_status": {
          "enum": [
            "primary_original",
            "primary_reproduction",
            "secondary",
            "discovery_only",
            "unknown"
          ]
        },
        "source_format": {
          "enum": [
            "audio",
            "video",
            "scan",
            "official_report",
            "checked_delivery_transcript",
            "contemporary_transcript",
            "manuscript",
            "published_book",
            "web_text",
            "other",
            "unknown"
          ]
        },
        "event_date": { "$ref": "#/$defs/dateValue" },
        "publication_date": { "$ref": "#/$defs/dateValue" },
        "canonical_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "stable_document_id": { "$ref": "#/$defs/nullableString" },
        "archive_reference": { "$ref": "#/$defs/nullableString" },
        "edition": { "$ref": "#/$defs/nullableString" },
        "isbn": { "$ref": "#/$defs/nullableString" },
        "accessed_at": { "type": "string", "format": "date-time" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": [
            "page",
            "chapter",
            "section",
            "paragraph",
            "hansard_column",
            "archive_folio",
            "timecode",
            "document_fragment",
            "other"
          ]
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "locator",
        "evidence_excerpt",
        "analyst_note",
        "passage_primary_status",
        "support_type",
        "targets"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "locator": { "$ref": "#/$defs/locator" },
        "evidence_excerpt": { "$ref": "#/$defs/nullableString" },
        "analyst_note": { "type": "string", "minLength": 1 },
        "passage_primary_status": {
          "enum": [
            "primary_original",
            "primary_reproduction",
            "secondary",
            "discovery_only",
            "unknown"
          ]
        },
        "support_type": { "enum": ["direct", "corroborating", "analytical_inference"] },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceTarget" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "evidenceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["json_pointer", "claim_id"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "fieldStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "status", "reason"],
      "properties": {
        "field_path": { "type": "string", "pattern": "^/" },
        "status": { "enum": ["known", "none", "unknown", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "reason", "evidence_ids"],
      "properties": {
        "label": { "enum": ["very_high", "high", "medium", "low", "unknown"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "confidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quotation_wording",
        "attribution",
        "source_event",
        "date",
        "historical_context",
        "editorial_interpretation"
      ],
      "properties": {
        "quotation_wording": { "$ref": "#/$defs/confidence" },
        "attribution": { "$ref": "#/$defs/confidence" },
        "source_event": { "$ref": "#/$defs/confidence" },
        "date": { "$ref": "#/$defs/confidence" },
        "historical_context": { "$ref": "#/$defs/confidence" },
        "editorial_interpretation": { "$ref": "#/$defs/confidence" }
      }
    },
    "unresolvedWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_unresolved", "questions", "searches_attempted", "next_actions"],
      "properties": {
        "is_unresolved": { "type": "boolean" },
        "questions": { "type": "array", "items": { "type": "string" } },
        "searches_attempted": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "quote_hash",
        "quote_text",
        "source_occurrences",
        "verification",
        "source_events",
        "historical_context",
        "entities",
        "meaning",
        "editorial_guidance",
        "sources",
        "evidence",
        "confidence",
        "field_status",
        "unresolved_work",
        "researched_at",
        "last_verified_at"
      ],
      "properties": {
        "quote_id": { "$ref": "#/$defs/sha256" },
        "quote_hash": { "$ref": "#/$defs/sha256" },
        "quote_text": { "type": "string", "minLength": 1 },
        "source_occurrences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceOccurrence" }
        },
        "verification": { "$ref": "#/$defs/verification" },
        "source_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceEvent" }
        },
        "historical_context": { "$ref": "#/$defs/historicalContext" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "meaning": { "$ref": "#/$defs/meaning" },
        "editorial_guidance": { "$ref": "#/$defs/editorialGuidance" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "confidence": { "$ref": "#/$defs/confidenceSet" },
        "field_status": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldStatus" }
        },
        "unresolved_work": { "$ref": "#/$defs/unresolvedWork" },
        "researched_at": { "type": "string", "format": "date-time" },
        "last_verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "unresolvedQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote_id", "reason_code", "detail", "sources_searched", "next_action"],
      "properties": {
        "quote_id": { "$ref": "#/$defs/sha256" },
        "reason_code": {
          "enum": [
            "no_reliable_source",
            "conflicting_sources",
            "date_unresolved",
            "speaker_unresolved",
            "possible_composite",
            "source_inaccessible",
            "manual_review_required",
            "other"
          ]
        },
        "detail": { "type": "string", "minLength": 1 },
        "sources_searched": { "type": "array", "items": { "type": "string" } },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "semantic_validator_version", "passed", "errors", "warnings"],
      "properties": {
        "schema_id": { "const": "urn:mrs-m-thatcher:quote-research:schema:2" },
        "semantic_validator_version": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
