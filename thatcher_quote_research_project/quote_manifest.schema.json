{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mrs-m-thatcher:quote-manifest:schema:1",
  "title": "Margaret Thatcher quotation source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "builder_version",
    "source_file",
    "quote_id_algorithm",
    "records",
    "occurrences"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "builder_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_file": { "$ref": "#/$defs/sourceFile" },
    "quote_id_algorithm": {
      "const": "sha256(exact UTF-8 quote_text without line ending)"
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifestRecord" }
    },
    "occurrences": {
      "type": "array",
      "items": { "$ref": "#/$defs/occurrenceIndexEntry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lineLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_number"],
      "properties": {
        "line_number": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "encoding",
        "line_endings",
        "final_newline",
        "source_occurrence_count",
        "unique_quote_count"
      ],
      "properties": {
        "name": { "const": "mrsMThatcher.txt" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "encoding": { "const": "US-ASCII" },
        "line_endings": { "const": "LF" },
        "final_newline": { "const": true },
        "source_occurrence_count": { "type": "integer", "minimum": 0 },
        "unique_quote_count": { "type": "integer", "minimum": 0 }
      }
    },
    "manifestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "quote_hash",
        "quote_text",
        "source_occurrences",
        "research_status"
      ],
      "properties": {
        "quote_id": { "$ref": "#/$defs/sha256" },
        "quote_hash": { "$ref": "#/$defs/sha256" },
        "quote_text": { "type": "string", "minLength": 1 },
        "source_occurrences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lineLocator" }
        },
        "research_status": {
          "enum": ["pending", "researching", "researched", "validated", "blocked"]
        }
      }
    },
    "occurrenceIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_number", "quote_id"],
      "properties": {
        "line_number": { "type": "integer", "minimum": 1 },
        "quote_id": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
