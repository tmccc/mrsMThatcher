          "maxItems": 5,
          "uniqueItems": true
        },
        "adjudication_before_machine_comparison": {"const": true},
        "gold_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "hash_algorithm",
            "locked_before_machine_ledger_reveal",
            "locked_before_machine_scoring"
