            {"const": "production_pipeline_decision"},
            {"const": "historical_account_reply"},
            {"const": "arm_identity"},
            {"const": "provider_or_model_identity"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        },
        "annotation_dimensions": {
          "type": "array",
