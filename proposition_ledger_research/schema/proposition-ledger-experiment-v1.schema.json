        "adjudication_before_machine_comparison",
        "gold_lock",
        "machine_reveal",
        "ledger_gold_boundary",
        "arm_d_scope"
      ],
      "properties": {
        "rubric_status": {"enum": ["pending_phase2_freeze", "frozen"]},
        "construction_input": {"const": "exact_transcript_prefix"},
        "independent_raters": {"const": 2},
        "rater_annotations_independently_authored": {"const": true},
        "rater_hidden_information": {
          "type": "array",
