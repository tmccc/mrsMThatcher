            {"const": "obligations"},
            {"const": "proposition_relations"},
            {"const": "answer_targets"},
            {"const": "rejected_answer_targets"},
            {"const": "uncertainty_and_abstentions"}
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true
        },
        "disagreement_resolution": {"const": "blinded_adjudicator_resolves_from_transcript_and_two_independent_annotations"},
        "adjudicator_input": {"const": "exact_transcript_prefix_and_two_independent_annotations"},
        "adjudicator_hidden_information": {
          "type": "array",
          "prefixItems": [
            {"const": "machine_ledger"},
            {"const": "production_pipeline_decision"},
            {"const": "historical_account_reply"},
            {"const": "arm_identity"},
            {"const": "provider_or_model_identity"}
          ],
          "items": false,
