          "properties": {
            "artifact": {"const": "transcript_first_independently_adjudicated_proposition_ledger"},
            "hash_algorithm": {"const": "sha256"},
            "locked_before_machine_ledger_reveal": {"const": true},
            "locked_before_machine_scoring": {"const": true}
          }
        },
        "machine_reveal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permitted_only_after_gold_lock", "locked_gold_supplies_arm_d_representation"],
          "properties": {
            "permitted_only_after_gold_lock": {"const": true},
            "locked_gold_supplies_arm_d_representation": {"const": true}
          }
        },
        "ledger_gold_boundary": {"const": "transcript_first_independently_adjudicated_subset_only"},
