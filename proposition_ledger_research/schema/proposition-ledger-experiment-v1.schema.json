      "properties": {
        "status": {"enum": ["pending_phase2_freeze", "frozen"]},
        "must_freeze_before_calls": {"const": true},
        "criteria": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_labels_hidden", "source_identity_hidden_where_safe", "rater_assignment_hidden", "unblinding_sequence", "status"],
      "properties": {
        "condition_labels_hidden": {"const": true},
        "source_identity_hidden_where_safe": {"const": true},
        "rater_assignment_hidden": {"const": true},
        "unblinding_sequence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 3},
        "status": {"enum": ["pending_phase2_freeze", "frozen"]}
      }
    }
  }
