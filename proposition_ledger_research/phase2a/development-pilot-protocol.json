        "post_target_extension_withheld": true,
        "selected_prefix_immutability_status": "frozen_at_cutoff"
      },
      "maximum_selected_conversations": 1,
      "required_guards": [
        "conversation and target are directly exposed",
        "target and every included turn are Grade A",
        "exact text exists for every prefix turn",
        "every ancestor relationship is exact",
        "turn order is unambiguous",
        "entire selected prefix existed by the frozen cutoff",
        "target author identity is exact, available and non-conflicting",
        "target is not genuinely unexposed",
        "target is not preliminarily held out",
        "target is not structurally mined-only",
        "required stressor labels pre-date Phase 2A",
        "no stable directly exposed substitute carries the same required compound-allegation label",
        "no later turn is included",
        "no post-cutoff extension is included",
        "no later turn is used for ledger construction, diagnosis or scoring",
        "no other selected conversation uses the exception"
      ],
      "source_record_stability_must_remain": "open_at_frozen_cutoff",
      "source_resolution": "locate deterministically from the exposed-only sidecar and pre-existing frozen calibration tags without a hard-coded real identifier or semantic mining of unlabelled transcripts"
    },
    "group_constraints": {
      "at_least_distinct_comparable_groups_where_pool_permits": 6,
      "maximum_conversations_per_comparable_group": 2,
      "raw_contributor_ids_in_outputs": false
    },
    "one_deepest_target_per_conversation": true,
    "overlapping_shorter_prefix_reruns": false,
    "selection_algorithm_version": "phase2a-development-selection-v2",
    "selection_policy_version": "phase2a-development-selection-v2",
    "selection_precedes_phase2a_model_output": true,
    "single_exception_may_cover_stressors_4_and_6": true,
    "source_family_goal": "include both benchmark and prospective-v4 where feasible",
    "stressor_priority": [
      {
        "priority": 1,
        "stressor": "existence or availability versus security, durability or independence"
      },
      {
        "priority": 2,
        "stressor": "valid distinction previously ignored or answered through a weaker nearby proposition"
      },
      {
        "priority": 3,
        "stressor": "still-live counterfactual or conditional issue"
      },
      {
        "priority": 4,
        "stressor": "compound allegation requiring separate conduct, causation, outcome or motive propositions"
      },
      {
        "priority": 5,
        "stressor": "explicit correction, qualification or not-X-but-Y relation"
      },
      {
        "priority": 6,
        "stressor": "account clarification followed by an apparent contributor answer, including the exposed Greater London Council calibration case when available and Grade A"
      },
      {
        "priority": 7,
        "stressor": "rhetorical or expressive contribution for which no_stable_issue is legitimate"
      },
      {
        "priority": 8,
        "stressor": "healthy sustained debate, partial concession, multilingual exchange or other control without a known proposition-substitution defect"
      }
    ],
    "tie_breakers_in_order": [
      "complete Grade-A status",
      "direct exposure strength",
      "greater relevant conversation depth",
      "contributor-group diversity",
      "source-family diversity",
      "stable calibration-case identifier in lexical order"
