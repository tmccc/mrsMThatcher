      "exposure evidence inconsistent",
      "exposure evidence ambiguous",
      "target author identity unavailable or conflicting",
      "inexact ancestor link",
      "incomplete target text",
      "non-Grade-A included turn",
      "conversation not frozen historical or quiescent at cutoff and frozen-open-prefix exception unavailable"
