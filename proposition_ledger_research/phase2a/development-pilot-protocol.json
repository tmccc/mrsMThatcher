  "case_selection": {
    "ancestor_policy": "complete exact untruncated ancestor prefix to one deepest development target",
    "candidate_gate_order": [
      "consume only the completed exposed-development-candidate-index.jsonl sidecar",
      "require consistent affirmative direct-exposure evidence",
      "require complete Grade-A reconstruction, exact target text, exact ancestor links, non-conflicting target author identity, and required publication identity",
      "require frozen-historical or quiescent status unless every frozen-open-prefix exception guard passes",
      "reconstruct the complete prefix and withhold every future or historical later turn",
      "apply stressor assignment and deterministic selection"
