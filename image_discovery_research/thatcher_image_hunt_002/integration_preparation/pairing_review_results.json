      "new_image_score": 54.001256,
      "pair_id": "7cdcd67a8066a3b12d28:b2d7265d79b80783486dc5fdff82f5d3ac3bd774fd46216e854a1f9abc00e30a",
      "quote_id": "b2d7265d79b80783486dc5fdff82f5d3ac3bd774fd46216e854a1f9abc00e30a",
      "quote_text": "When I was British Prime Minister I was not always popular. Reformers rarely are while reforms are going through, though if we struggle on we reap the rewards later.",
      "review_note": ""
