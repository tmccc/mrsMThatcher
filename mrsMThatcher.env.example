# Sanitized example environment for MrsMThatcher.
# Copy to mrsMThatcher.env, fill with real secrets, chmod 600, and do not commit.
# MRS_BOT_SCRIPT is intentionally omitted: it is test-only and rejected in production.

export X_CONSUMER_KEY='replace-with-x-consumer-key'
export X_CONSUMER_SECRET='replace-with-x-consumer-secret'
export X_ACCESS_TOKEN='replace-with-x-access-token'
export X_ACCESS_SECRET='replace-with-x-access-secret'
export X_MY_USER_ID='replace-with-x-user-id'
export X_BEARER_TOKEN='replace-with-x-bearer-token'
export XAI_API_KEY='replace-with-xai-api-key'
